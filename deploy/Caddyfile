# TypeWar 反向代理示例 · Caddy
#
# Caddy 会自动申请并续期 HTTPS 证书，WebSocket 升级开箱可用。
#
# 用法：
#   1) 域名 A 记录指向服务器公网 IP
#   2) 服务端以 --bind 127.0.0.1 启动（只监听本机，由 Caddy 对外）
#      sudo ./deploy/install.sh --bind 127.0.0.1
#   3) sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# 把 game.example.com 换成你自己的域名。

game.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
